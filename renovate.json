{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekdays", ":gitSignOff"],
  "schedule": ["before 9am on Monday"],
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "24 hours",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Group and automerge all non-major updates into a single PR",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Major updates get individual PRs for manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Pin GitHub Actions to SHA digests",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "apps/docs is stuck on TypeScript 6 until astro check supports the native compiler — see https://github.com/withastro/roadmap/discussions/1321",
      "matchFileNames": ["apps/docs/package.json"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on Monday"]
  }
}
