{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "words": [
    "mycollections",
    "autoincrement",
    "upsert",
    "upserts",
    "barcodes",
    "biomejs",
    "depscore",
    "esbuild",
    "frontmatter",
    "Turborepo",
    "commitlint",
    "Fastify",
    "pnpm",
    "tanstack",
    "tsbuildinfo",
    "tsconfig",
    "turbo",
    "vitest",
    "predev",
    "prebuild",
    "astrojs",
    "Pagefind",
    "tsconfck",
    "gpgsign",
    "shusak",
    "PVTSSF",
    "PKCE",
    "Tauri",
    "vite",
    "unstub",
    "WCAG",
    "cutover",
    "languagedetector",
    "unhandledrejection",
    "Bricolage",
    "woff",
    "wordmark"
  ],
  "ignoreRegExpList": ["/PVT_[a-zA-Z0-9]+/g", "/PVTSSF_[a-zA-Z0-9]+/g", "/[a-f0-9]{8,}/g"],
  "enableGlobDot": false,
  "ignorePaths": ["node_modules", "dist", "build", "coverage", ".turbo", "pnpm-lock.yaml", ".git"]
}
