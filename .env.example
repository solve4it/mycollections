# MyCollections Environment Variables
# Copy this file to .env and fill in your values.
# Values below are the API server's actual defaults.

# Server
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Bearer token required by the API. Defaults to a random UUID regenerated on
# every restart (printed to stdout in dev); set it for a stable dev token.
API_TOKEN=

# SQLite database file. Defaults to apps/api/data/app.db (anchored to the app
# directory, independent of the working directory the server starts from).
DB_PATH=

# Logging: fatal | error | warn | info | debug | trace | silent
# Defaults to debug in dev, info in production.
LOG_LEVEL=info
