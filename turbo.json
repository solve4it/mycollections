{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      // Turbo's default env mode is strict: a task sees only the variables named here,
      // so without this list `PORT=… pnpm dev` starts a server on 3001 and says nothing.
      // Every variable the local servers read has to be passed through by name.
      "passThroughEnv": [
        "API_TOKEN",
        // BROWSER=none and CI stop the first-run pairing link opening a browser (#241);
        // DISPLAY and friends are what xdg-open needs to find the desktop session on Linux.
        "BROWSER",
        "CI",
        "DB_PATH",
        "DBUS_SESSION_BUS_ADDRESS",
        "DEV_ORIGINS",
        "DISPLAY",
        "HOST",
        "LOG_LEVEL",
        "MEDIA_DIR",
        "PORT",
        "VITE_API_URL",
        "WAYLAND_DISPLAY",
        "XDG_RUNTIME_DIR"
      ]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      // ^build so the API entrypoint's workspace dependencies (core, db, auth)
      // have a dist for tsx to import. Never cached: the result depends on a
      // browser binary and two servers, none of which are inputs turbo can hash.
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
