{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // The integration test boots the API as a Node subprocess and uses Node APIs.
  // It runs under vitest, but is a node-context file, so it is excluded from this
  // browser-targeted typecheck.
  "exclude": ["src/**/*.integration.test.ts"]
}
